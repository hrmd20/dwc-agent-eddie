{
  "name": "EDDIE Async Reaction",
  "style": "async-reaction",
  "version": "1.0.0",
  "canvas": {
    "width": 2160,
    "height": 3840,
    "fps": 30
  },
  "reference": ".agents/skills/eddie/references/reaction-async.md",
  "sequence": [
    "full-screen source excerpt",
    "full-screen doctor commentary"
  ],
  "synchronizedInset": false,
  "captions": {
    "position": "fixed-below-beard-base-of-neck",
    "referenceCenterY": 2300,
    "fontSize": 134,
    "maxWords": 3,
    "color": "#FFFFFF",
    "highlight": null,
    "stroke": "#000000",
    "stationary": true,
    "fontFamily": "Arial",
    "fontWeight": "bold",
    "animation": "none"
  },
  "supportingVisuals": {
    "optional": true,
    "position": "below captions",
    "preserveAspectRatio": true
  },
  "audio": {
    "gainMultiplier": 1.5,
    "applyGainOnce": true,
    "peakProtection": true,
    "addedVoiceOver": false,
    "voiceCleanup": {
      "speechIsolation": "conservative; assess and bypass if unnecessary",
      "denoise": "gentle; preserve natural voice",
      "applyOnce": true,
      "encodedPeakCheck": true
    }
  },
  "export": {
    "codec": "h264",
    "crf": 18,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioSampleRate": 48000,
    "fastStart": true
  },
  "hook": {
    "enabled": true,
    "startSeconds": 0,
    "durationSeconds": 3,
    "position": "top-centered",
    "referenceCanvas": [
      2160,
      3840
    ],
    "top": 160,
    "width": 1920,
    "maxLines": 2,
    "fontFamily": "Arial Bold",
    "fontSize": 116,
    "background": "#FFFFFF",
    "textColor": "#000000",
    "emphasisColor": "#FF0000",
    "cornerRadius": 52,
    "verticalPadding": 44,
    "height": "visible text ink bounds plus twice verticalPadding",
    "centerVisibleInk": true,
    "reference": "references/text-hook.md"
  },
  "qualityDefaults": ".agents/skills/eddie/references/quality-defaults.md"
}
