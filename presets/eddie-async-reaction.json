{
  "name": "EDDIE Async Reaction",
  "style": "async-reaction",
  "version": "1.0.0",
  "canvas": {
    "width": 2160,
    "height": 3840,
    "fps": 30
  },
  "reference": ".agents/skills/eddie/references/reaction-async.md",
  "sequence": [
    "full-screen source excerpt",
    "full-screen doctor commentary"
  ],
  "synchronizedInset": false,
  "captions": {
    "position": "fixed-below-beard-base-of-neck",
    "referenceCenterY": 2300,
    "fontSize": 134,
    "maxWords": 3,
    "color": "#FFFFFF",
    "highlight": null,
    "stroke": "#000000",
    "stationary": true,
    "fontFamily": "Arial",
    "fontWeight": "bold",
    "animation": "none"
  },
  "supportingVisuals": {
    "optional": true,
    "position": "below captions",
    "preserveAspectRatio": true
  },
  "audio": {
    "gainMultiplier": 1.5,
    "applyGainOnce": true,
    "peakProtection": true,
    "addedVoiceOver": false,
    "voiceCleanup": {
      "speechIsolation": "conservative; assess and bypass if unnecessary",
      "denoise": "gentle; preserve natural voice",
      "applyOnce": true,
      "encodedPeakCheck": true
    }
  },
  "export": {
    "codec": "h264",
    "crf": 18,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioSampleRate": 48000,
    "fastStart": true
  },
  "hook": {
    "enabled": true,
    "startSeconds": 0,
    "durationSeconds": 3,
    "position": "hairline-relative-stable-per-shot",
    "referenceCanvas": [
      2160,
      3840
    ],
    "width": "widest visible line plus twice horizontal padding",
    "maxLines": 2,
    "fontFamily": "Arial Bold",
    "fontSize": 140,
    "background": "rgba(72,72,69,0.71)",
    "textColor": "#FFFFFF",
    "emphasisColor": "#FFC400",
    "cornerRadius": 52,
    "verticalPadding": 50,
    "height": "combined visible text bounds plus equal vertical padding",
    "centerVisibleInk": true,
    "reference": "references/text-hook.md",
    "container": "single-rounded-rectangle-for-entire-hook",
    "horizontalPadding": 52,
    "lineInkGap": 40,
    "upwardAdjustmentPixels": 16,
    "maxWidth": 2040
  },
  "qualityDefaults": ".agents/skills/eddie/references/quality-defaults.md"
}
