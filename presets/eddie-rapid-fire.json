{
  "name": "EDDIE Rapid Fire (Text hook, captions, images)",
  "version": "1.0.0",
  "canvas": {
    "width": 2160,
    "height": 3840,
    "fps": 30
  },
  "captions": {
    "font": "Arial Bold",
    "size": 134,
    "color": "#FFFFFF",
    "outline_color": "#000000",
    "outline_width": 8,
    "center": [
      1080,
      2120
    ],
    "rating_size": 192
  },
  "hook": {
    "start": 0,
    "end": 3,
    "top": 160,
    "width": 1920,
    "height": "visible ink height + 88",
    "font_size": 116,
    "background": "#FFFFFF",
    "text_color": "#000000",
    "emphasis_color": "#FF0000",
    "corner_radius": 52,
    "placement": "top-centered",
    "max_lines": 2,
    "vertical_padding": 44,
    "center_visible_ink": true
  },
  "images": {
    "top": 2260,
    "max_width": 1280,
    "max_height": 940,
    "fit": "contain",
    "transition": "hard pop",
    "timing": "question through answer",
    "source": "Google Images unless supplied or explicitly selected alternatives"
  },
  "audio": {
    "source": "original recording",
    "gain": 1.5,
    "voiceover": false,
    "music": false,
    "sound_effects": false,
    "voiceCleanup": {
      "speechIsolation": "conservative; assess and bypass if unnecessary",
      "denoise": "gentle; preserve natural voice",
      "applyOnce": true,
      "encodedPeakCheck": true
    }
  },
  "interviewer": {
    "mode": "infer from brief or ask",
    "supported_modes": [
      "recorded interviewer",
      "AI-generated interviewer"
    ],
    "recorded_camera_layout": "preserve shared shot or cut nurse questions to doctor answers",
    "ai_voice": "user-selected provider and voice",
    "ai_speed": "user-selected",
    "response_gap_seconds": "user-selected; reference example 5",
    "embedded_question_audio": "reuse; never duplicate"
  },
  "audioGain": {
    "multiplier": 1.5,
    "decibels": 3.5218,
    "applyOnceToCleanSource": true,
    "peakProtection": true
  },
  "qualityDefaults": ".agents/skills/eddie/references/quality-defaults.md"
}
