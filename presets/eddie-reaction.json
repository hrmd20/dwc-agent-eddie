{
  "name": "EDDIE Sync Reaction",
  "style": "sync-reaction",
  "version": "1.1.0",
  "canvas": {
    "width": 2160,
    "height": 3840,
    "fps": 30
  },
  "sync": {
    "offsetSeconds": null,
    "measureEachProject": true,
    "preserveContinuousSource": true
  },
  "captions": {
    "font": "Arial",
    "bold": true,
    "uppercase": true,
    "fill": "#FFFFFF",
    "activeWord": "#F1D688",
    "outline": "#080C12",
    "outlineWidth": 6,
    "shadow": 2,
    "maxWords": 3,
    "maxCharacters": 23,
    "stationaryWithinLayout": true,
    "coordinateUnits": "ASS/libass",
    "source": {
      "x": 1080,
      "y": 2520,
      "size": 124
    },
    "commentary": {
      "x": 1080,
      "y": 1860,
      "size": 136
    }
  },
  "audio": {
    "duringSource": "original source audio only",
    "afterSource": "doctor commentary audio only",
    "targetIntegratedLUFS": -14,
    "maxTruePeakDbTP": -1,
    "click": "only when explicitly requested",
    "music": false,
    "peakProtection": true
  },
  "export": {
    "codec": "h264",
    "crf": 18,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioSampleRate": 48000,
    "fastStart": true
  },
  "hook": {
    "enabled": true,
    "startSeconds": 0,
    "durationSeconds": 3,
    "position": "top-safe-area-clear-of-faces-and-source-captions",
    "referenceCanvas": [
      2160,
      3840
    ],
    "width": "widest visible line plus twice horizontal padding",
    "maxLines": 2,
    "fontFamily": "Arial Bold",
    "fontSize": 140,
    "background": "rgba(72,72,69,0.71)",
    "textColor": "#FFFFFF",
    "emphasisColor": "#FFC400",
    "cornerRadius": 52,
    "verticalPadding": 50,
    "height": "combined visible text bounds plus equal vertical padding",
    "centerVisibleInk": true,
    "reference": "references/text-hook.md",
    "container": "single-rounded-rectangle-for-entire-hook",
    "horizontalPadding": 52,
    "lineInkGap": 40,
    "upwardAdjustmentPixels": 16,
    "maxWidth": 2040
  },
  "qualityDefaults": ".agents/skills/eddie/references/quality-defaults.md",
  "composition": {
    "default": "rounded-source-overlay",
    "layerOrderBackToFront": [
      "reframed doctor base",
      "rounded moving source overlay with soft drop shadow",
      "optional masked doctor foreground",
      "captions and top hook"
    ],
    "reference": ".agents/skills/eddie/references/reaction-sync.md",
    "fallback": "approved or explicitly requested layout"
  },
  "sourceOverlay": {
    "placement": "calibrate per shot",
    "fit": "contain",
    "cornerRadius": 48,
    "shadow": {
      "color": "#000000",
      "opacity": 0.25,
      "blurPixels": 24,
      "offsetYPixels": 12
    }
  }
}
