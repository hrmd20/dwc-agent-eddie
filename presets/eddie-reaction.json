{
  "name": "EDDIE Sync Reaction",
  "style": "sync-reaction",
  "version": "1.0.0",
  "canvas": {
    "width": 2160,
    "height": 3840,
    "fps": 30
  },
  "sync": {
    "offsetSeconds": null,
    "measureEachProject": true,
    "preserveContinuousSource": true
  },
  "sourceRect": {
    "x": 120,
    "y": 64,
    "width": 1920,
    "height": 3412,
    "fit": "contain"
  },
  "reactionInset": {
    "x": 48,
    "y": 2928,
    "width": 648,
    "height": 864,
    "border": 6,
    "entryFrame": 2
  },
  "captions": {
    "font": "Arial",
    "bold": true,
    "uppercase": true,
    "fill": "#FFFFFF",
    "activeWord": "#F1D688",
    "outline": "#080C12",
    "outlineWidth": 6,
    "shadow": 2,
    "maxWords": 3,
    "maxCharacters": 23,
    "stationaryWithinLayout": true,
    "coordinateUnits": "ASS/libass",
    "source": {
      "x": 1080,
      "y": 2520,
      "size": 124
    },
    "insetSpeech": {
      "x": 1440,
      "y": 3620,
      "size": 92
    },
    "commentary": {
      "x": 1080,
      "y": 1860,
      "size": 136
    }
  },
  "audio": {
    "clickCount": 1,
    "clickLeadFrames": 2,
    "music": false,
    "truePeakDb": -1.5,
    "preserveLaughter": true,
    "avoidDoubledSourceAudio": true,
    "gainMultiplier": 1.5,
    "applyGainOnce": true,
    "peakProtection": true,
    "voiceCleanup": {
      "speechIsolation": "conservative; assess and bypass if unnecessary",
      "denoise": "gentle; preserve natural voice",
      "applyOnce": true,
      "encodedPeakCheck": true
    }
  },
  "export": {
    "codec": "h264",
    "crf": 18,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioSampleRate": 48000,
    "fastStart": true
  },
  "hook": {
    "enabled": true,
    "startSeconds": 0,
    "durationSeconds": 3,
    "position": "hairline-relative-stable-per-shot",
    "referenceCanvas": [
      2160,
      3840
    ],
    "width": "widest visible line plus twice horizontal padding",
    "maxLines": 2,
    "fontFamily": "Arial Bold",
    "fontSize": 140,
    "background": "rgba(72,72,69,0.71)",
    "textColor": "#FFFFFF",
    "emphasisColor": "#FFC400",
    "cornerRadius": 52,
    "verticalPadding": 50,
    "height": "combined visible text bounds plus equal vertical padding",
    "centerVisibleInk": true,
    "reference": "references/text-hook.md",
    "container": "single-rounded-rectangle-for-entire-hook",
    "horizontalPadding": 52,
    "lineInkGap": 40,
    "upwardAdjustmentPixels": 16,
    "maxWidth": 2040
  },
  "qualityDefaults": ".agents/skills/eddie/references/quality-defaults.md"
}
