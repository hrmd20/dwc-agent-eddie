{
  "name": "EDDIE Sync Reaction",
  "style": "sync-reaction",
  "version": "1.0.0",
  "canvas": {
    "width": 2160,
    "height": 3840,
    "fps": 30
  },
  "sync": {
    "offsetSeconds": null,
    "measureEachProject": true,
    "preserveContinuousSource": true
  },
  "sourceRect": {
    "x": 120,
    "y": 64,
    "width": 1920,
    "height": 3412,
    "fit": "contain"
  },
  "reactionInset": {
    "x": 48,
    "y": 2928,
    "width": 648,
    "height": 864,
    "border": 6,
    "entryFrame": 2
  },
  "captions": {
    "font": "Arial",
    "bold": true,
    "uppercase": true,
    "fill": "#FFFFFF",
    "activeWord": "#F1D688",
    "outline": "#080C12",
    "outlineWidth": 6,
    "shadow": 2,
    "maxWords": 3,
    "maxCharacters": 23,
    "stationaryWithinLayout": true,
    "coordinateUnits": "ASS/libass",
    "source": {
      "x": 1080,
      "y": 2520,
      "size": 124
    },
    "insetSpeech": {
      "x": 1440,
      "y": 3620,
      "size": 92
    },
    "commentary": {
      "x": 1080,
      "y": 1860,
      "size": 136
    }
  },
  "audio": {
    "clickCount": 1,
    "clickLeadFrames": 2,
    "music": false,
    "truePeakDb": -1.5,
    "preserveLaughter": true,
    "avoidDoubledSourceAudio": true,
    "gainMultiplier": 1.5,
    "applyGainOnce": true,
    "peakProtection": true,
    "voiceCleanup": {
      "speechIsolation": "conservative; assess and bypass if unnecessary",
      "denoise": "gentle; preserve natural voice",
      "applyOnce": true,
      "encodedPeakCheck": true
    }
  },
  "export": {
    "codec": "h264",
    "crf": 18,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioSampleRate": 48000,
    "fastStart": true
  },
  "hook": {
    "enabled": true,
    "startSeconds": 0,
    "durationSeconds": 3,
    "position": "top-centered",
    "referenceCanvas": [
      2160,
      3840
    ],
    "top": 160,
    "width": 1920,
    "maxLines": 2,
    "fontFamily": "Arial Bold",
    "fontSize": 116,
    "background": "#FFFFFF",
    "textColor": "#000000",
    "emphasisColor": "#FF0000",
    "cornerRadius": 52,
    "verticalPadding": 44,
    "height": "visible text ink bounds plus twice verticalPadding",
    "centerVisibleInk": true,
    "reference": "references/text-hook.md"
  },
  "qualityDefaults": ".agents/skills/eddie/references/quality-defaults.md"
}
