{
  "name": "EDDIE Classic",
  "version": 2,
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "captions": {
    "position": "fixed-below-beard-base-of-neck",
    "referenceCenterY": 1150,
    "fontSize": 67,
    "maxWords": 3,
    "color": "#FFFFFF",
    "highlight": null,
    "stroke": "#000000",
    "stationary": true,
    "fontFamily": "Arial",
    "fontWeight": "bold",
    "animation": "none"
  },
  "images": {
    "position": "directly-below-captions",
    "referenceTopY": 1200,
    "gapPixels": 20,
    "maxWidth": 860,
    "maxHeight": 540,
    "preserveAspectRatio": true,
    "optional": true,
    "entry": "instant",
    "exit": "instant",
    "hold": "static",
    "source": "user-supplied-or-explicitly-selected"
  },
  "motion": {
    "enabled": false,
    "enterSeconds": 0,
    "startScale": 1,
    "fadeInSeconds": 0,
    "exitSeconds": 0
  },
  "audio": {
    "clickLeadFrames": 2,
    "otherEffects": false,
    "clickOptional": true,
    "clickEnabledWhen": "user-supplied-and-requested",
    "clickOnExit": false,
    "clickOnCaptionChange": false,
    "addedMusic": false
  },
  "graphics": {
    "mode": "none",
    "automaticIntro": false,
    "automaticOutro": false
  },
  "calibration": "Calibrate once just below the beard/base of neck; keep captions stationary and pictures directly below the reserved caption bounds. Reference coordinates are starting points.",
  "styleId": "eddie-classic",
  "releaseVersion": "1.1.0"
}
