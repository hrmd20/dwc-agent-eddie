{
  "name": "EDDIE MASTER EDITOR",
  "version": 2,
  "canvas": {
    "width": 2160,
    "height": 3840,
    "fps": 30
  },
  "captions": {
    "position": "fixed-below-beard-base-of-neck",
    "referenceCenterY": 2300,
    "fontSize": 134,
    "maxWords": 3,
    "color": "#FFFFFF",
    "highlight": null,
    "stroke": "#000000",
    "stationary": true,
    "fontFamily": "Arial",
    "fontWeight": "bold",
    "animation": "none"
  },
  "images": {
    "position": "directly-below-captions",
    "referenceTopY": 2400,
    "gapPixels": 40,
    "maxWidth": 1720,
    "maxHeight": 1080,
    "preserveAspectRatio": true,
    "optional": true,
    "entry": "instant",
    "exit": "instant",
    "hold": "static",
    "source": "user-supplied-or-explicitly-selected"
  },
  "motion": {
    "enabled": false,
    "enterSeconds": 0,
    "startScale": 1,
    "fadeInSeconds": 0,
    "exitSeconds": 0
  },
  "audio": {
    "clickLeadFrames": 2,
    "otherEffects": false,
    "clickOptional": true,
    "clickEnabledWhen": "user-supplied-and-requested",
    "clickOnExit": false,
    "clickOnCaptionChange": false,
    "addedMusic": false,
    "voiceCleanup": {
      "speechIsolation": "conservative; assess and bypass if unnecessary",
      "denoise": "gentle; preserve natural voice",
      "applyOnce": true,
      "encodedPeakCheck": true
    }
  },
  "graphics": {
    "mode": "none",
    "automaticIntro": false,
    "automaticOutro": false
  },
  "calibration": "Calibrate once just below the beard/base of neck; keep captions stationary and pictures directly below the reserved caption bounds. Reference coordinates are starting points.",
  "styleId": "eddie-classic",
  "releaseVersion": "1.2.0",
  "iphoneMessages": {
    "enabled": false,
    "activation": "Explicit request for text messages or iPhone notifications on screen",
    "reference": "references/iphone-messages.md"
  },
  "rapidFire": {
    "selection": "Auto-detect repeated short Q&A, yes/no or ranking script unless user specifies otherwise",
    "reference": "references/rapid-fire.md",
    "hookDurationSeconds": 3,
    "imageSource": "Google images, unless user supplies or selects alternatives"
  },
  "audioGain": {
    "multiplier": 1.5,
    "decibels": 3.5218,
    "applyOnceToCleanSource": true,
    "peakProtection": true
  },
  "modes": [
    "captions-hook",
    "captions-google-images-hook",
    "rapid-fire",
    "sync-reaction",
    "async-reaction"
  ],
  "hook": {
    "enabled": true,
    "startSeconds": 0,
    "durationSeconds": 3,
    "position": "hairline-relative-stable-per-shot",
    "referenceCanvas": [
      2160,
      3840
    ],
    "width": "widest visible line plus twice horizontal padding",
    "maxLines": 2,
    "fontFamily": "Arial Bold",
    "fontSize": 140,
    "background": "rgba(72,72,69,0.71)",
    "textColor": "#FFFFFF",
    "emphasisColor": "#FFC400",
    "cornerRadius": 52,
    "verticalPadding": 50,
    "height": "combined visible text bounds plus equal vertical padding",
    "centerVisibleInk": true,
    "reference": "references/text-hook.md",
    "container": "single-rounded-rectangle-for-entire-hook",
    "horizontalPadding": 52,
    "lineInkGap": 40,
    "upwardAdjustmentPixels": 16,
    "maxWidth": 2040
  },
  "framing": {
    "enabled": true,
    "appliesTo": "all five Master Editor modes",
    "reference": "references/framing.md",
    "directToCamera": "center unintentionally off-center single presenter",
    "preserveIntentionalAngles": true,
    "scale": "uniform",
    "crop": "stable per shot; smooth follow only when needed",
    "syntheticEyeContact": false,
    "topHookLayout": "default in all five modes; shared text-hook.md"
  },
  "reaction": {
    "reference": "references/reaction.md",
    "variants": {
      "sync": {
        "name": "EDDIE Sync Reaction",
        "reference": "references/reaction-sync.md",
        "layout": "rounded source overlay with a soft shadow and original audio, then full-screen doctor commentary and audio"
      },
      "async": {
        "name": "EDDIE Async Reaction",
        "reference": "references/reaction-async.md",
        "layout": "source excerpt first, then separately recorded full-screen doctor commentary",
        "images": "optional relevant supporting images or study excerpts below captions"
      }
    },
    "selection": "Honor explicit choice or approved edit; use footage and brief to select Sync versus Async",
    "hook": "approved charcoal and yellow hook in top safe area; use selected reaction timing",
    "composition": {
      "default": "use the selected reaction preset",
      "reference": ".agents/skills/eddie/references/reaction-cutout.md"
    }
  },
  "qualityDefaults": ".agents/skills/eddie/references/quality-defaults.md"
}
